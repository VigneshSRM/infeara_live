# Public site URL. Canonicals, sitemap, Open Graph and JSON-LD all read this.
SITE_URL=https://www.infeara.com

# Launch gate. false emits Disallow: / and noindex on every page.
SITE_INDEXABLE=false

# Supabase project. The publishable (anon) key is public by design; RLS protects
# the data. The service key is server-only and only needed for user invitations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Analytics, loaded only after consent. The measurement ID (G-...) is baked into the
# build, so changing it needs a new deployment.
NEXT_PUBLIC_GA4_ID=

# Visitor numbers on the CMS Overview, read back from the Google Analytics Data API.
# Both are server-only (never prefix them with NEXT_PUBLIC_). Without them the
# Overview shows a setup card instead of visitor numbers.
#   GA4_PROPERTY_ID            the numeric Property ID (Admin > Property details),
#                              NOT the G-... measurement ID
#   GA4_SERVICE_ACCOUNT_JSON   the whole JSON key of a Google service account that is
#                              a Viewer on that property (a secret: mark it Sensitive)
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
