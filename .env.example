# Public site URL. Canonicals, sitemap, Open Graph and JSON-LD all read this.
SITE_URL=https://www.infeara.com

# Launch gate. false emits Disallow: / and noindex on every page.
SITE_INDEXABLE=false

# Supabase project (anon key is public by design; service key is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signed webhook secret for on-demand revalidation
REVALIDATE_SECRET=

# Contact form delivery. Until CONTACT_WEBHOOK_URL is set, /api/contact returns
# 503 and the form falls back to the contact@infeara.com mailto address.
# Point this at a CRM/automation endpoint that accepts the JSON payload.
CONTACT_WEBHOOK_URL=
# Optional bearer token sent as Authorization: Bearer <value>.
CONTACT_WEBHOOK_SECRET=

# Analytics, loaded only after consent
NEXT_PUBLIC_GA4_ID=
